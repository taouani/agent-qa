{
  "name": "sf-agent-qa",
  "version": "2.0.0-alpha.0",
  "description": "Open-source QA agent: Jira, Confluence and Xray to masked, validated test cases and Playwright scripts, for Copilot, Claude Code, Cursor and CI.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taouani/agent-qa.git"
  },
  "homepage": "https://github.com/taouani/agent-qa#readme",
  "bugs": "https://github.com/taouani/agent-qa/issues",
  "keywords": [
    "qa",
    "testing",
    "jira",
    "xray",
    "playwright",
    "salesforce",
    "mcp"
  ],
  "engines": {
    "node": ">=20"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "agent-qa": "dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:tsc": "node scripts/build-tsc.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "changeset": "changeset",
    "release": "npm run check && changeset publish",
    "prepublishOnly": "npm run build",
    "schema": "npm run build && node scripts/write-schema.mjs"
  },
  "devDependencies": {
    "@babel/types": "^7.29.8",
    "@changesets/cli": "^2.31.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.4.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.96",
    "@ai-sdk/google": "^4.0.111",
    "@ai-sdk/mistral": "^4.0.79",
    "@ai-sdk/openai": "^4.0.108",
    "@ai-sdk/openai-compatible": "^3.0.84",
    "@ai-sdk/xai": "^5.0.38",
    "@babel/parser": "^7.29.9",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ai": "^7.0.162",
    "commander": "^12.1.0",
    "cross-spawn": "^7.0.6",
    "libphonenumber-js": "^1.13.15",
    "undici": "^6.29.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^2.1.2"
  }
}
